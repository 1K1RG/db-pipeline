# You may put input files in `input/`.
# Accepts `.vcf` or `.vcf.gz`.
# e.g. INPUT_VCF=input/1k1.vcf.gz
INPUT_VCF=

# e.g. OUTPUT_HDF5_NAME=PH1K1
OUTPUT_HDF5_NAME=

# HPC module that provides `mamba` or `conda` commands.
# Leave unset if either command is already on PATH.
# e.g. CONDA_MODULE=anaconda
CONDA_MODULE=
