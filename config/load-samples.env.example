VARIETY_SET_NAME=1k1
SNP_SET_NAME=1k1-all

# Must match the organism loaded by `jobs/load-reference.slurm`.
# e.g. REF_NAME="Japonica nipponbare"
REF_NAME=

# The name of the HDF5 file produced by this dataset's
# `jobs/generate-hdf5.slurm` run. It also selects the matrix directory the
# samples and positions are read from.
# Do not point to the actual path of the file.
# e.g. HDF5_FILE=PH1K1_transp.h5
HDF5_FILE=
